# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Choose exactly one MCP connection path for live Responses runs.
MCP_TUNNEL_ID=
MCP_SERVER_URL=
MCP_AUTH_TOKEN=

# Local MCP server settings. Keep the default loopback host when using Secure MCP Tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Presenter-only emergency fallback. Keep false for the normal reviewer UI.
ENABLE_FIXTURE_PREVIEW=false

# Optional pricing override. The app otherwise uses config/openai_pricing.json.
# If overriding, set every rate plus the observation date and official source URL.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_CACHED_INPUT_COST_PER_MILLION=
OPENAI_CACHE_WRITE_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
OPENAI_PRICING_OBSERVED_AT=
OPENAI_PRICING_SOURCE_URL=

